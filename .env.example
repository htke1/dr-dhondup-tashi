# =============================================================================
# DR. DHONDUP TASHI - ONLINE MEDICAL CONSULTATIONS
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for development.
# In production, set these variables in your Vercel Project Settings.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION BASE URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE & SUPABASE
# -----------------------------------------------------------------------------
# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (public, for client-side queries protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-ONLY, bypasses RLS for administrative actions)
# CRITICAL: NEVER expose this to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct PostgreSQL connection string for Prisma or migration scripts
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY
# -----------------------------------------------------------------------------
# Public Key ID used in checkout modal on the client
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Secret Key (SERVER-ONLY) used for order creation and signature verification
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook Secret (SERVER-ONLY) for validating webhook events from Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Consultation fee in INR (must match business rules: Rs 800)
NEXT_PUBLIC_CONSULTATION_FEE=800

# -----------------------------------------------------------------------------
# GOOGLE CALENDAR & GOOGLE MEET
# -----------------------------------------------------------------------------
# Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Persistent OAuth Refresh Token for the doctor's Google account
# (Obtained during initial authorization flow with calendar.events scope)
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token

# Target Google Calendar ID (primary or specific calendar ID)
GOOGLE_CALENDAR_ID=primary

# -----------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (RESEND)
# -----------------------------------------------------------------------------
# Resend API Key for sending booking confirmations, reminders, and notifications
RESEND_API_KEY=re_...

# Sender email address (must be a verified domain in Resend)
EMAIL_FROM="Dr. Dhondup Tashi" <consultations@drdhondup.com>

# Administrative notification recipient (system owner / admin email)
ADMIN_NOTIFICATION_EMAIL=sheraptenzin98@gmail.com

# Doctor's primary Google account for Calendar invites, Google Meet attendee access & notifications
DOCTOR_NOTIFICATION_EMAIL=dhontash@gmail.com
DOCTOR_EMAIL=dhontash@gmail.com

# -----------------------------------------------------------------------------
# UPI PAYMENT CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UPI_ID=dhontash@okicici
NEXT_PUBLIC_UPI_RECIPIENT_NAME="Dhondup Tashi"

# -----------------------------------------------------------------------------
# ADMIN DASHBOARD AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret passphrase / JWT secret for signing administrative session cookies
ADMIN_AUTH_SECRET=generate-a-strong-random-64-character-secret-string-here

# Designated administrator email(s) for dashboard access
ADMIN_EMAIL=drdhondup.tashi@gmail.com

# -----------------------------------------------------------------------------
# CRON & WEBHOOK PROTECTION
# -----------------------------------------------------------------------------
# Secret token used by Vercel Cron or external triggers to authenticate reminder jobs
CRON_SECRET=generate-a-strong-random-cron-secret-token-here
